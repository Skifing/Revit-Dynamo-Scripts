{
  "Uuid": "70dfd576-8251-455d-9988-ef47d7735722",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Массовое добавление параметра ФОП в семейства из папки с папкой исключением",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport re  # Импортируем регулярные выражения для фильтрации бэкапов\r\n\r\n# Импортируем службы Dynamo для работы с документом\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Импортируем API Revit\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Получаем доступ к приложению Revit\r\napp = DocumentManager.Instance.CurrentUIApplication.Application\r\n\r\n# Входные данные из нодов Dynamo (строго по порядку)\r\nfam_paths = IN[0]\r\nparam_name = IN[1]\r\ngroup_text = IN[2]  \r\nis_instance = IN[3]\r\nexclude_folder_path = IN[4]  # ПУТЬ К ПАПКЕ-ИСКЛЮЧЕНИЮ ИЗ НОДА DIRECTORY PATH\r\n\r\n# Превращаем входной путь в список, если подан всего один файл\r\nif not isinstance(fam_paths, list):\r\n    fam_paths = [fam_paths]\r\n\r\n# 1. Открываем ФОП и ищем определение параметра\r\ndef_file = app.OpenSharedParameterFile()\r\ntarget_def = None\r\n\r\nif def_file:\r\n    for group in def_file.Groups:\r\n        target_def = group.Definitions.get_Item(param_name)\r\n        if target_def:\r\n            break\r\n\r\n# Список для сбора результатов по каждому файлу\r\nresults = []\r\n\r\nif not target_def:\r\n    results.append(\"Параметр не найден в ФОП или ФОП не подключен в Revit.\")\r\nelse:\r\n    # 2. Получаем правильный ForgeTypeId для группы параметров\r\n    try:\r\n        param_group = getattr(GroupTypeId, group_text)\r\n    except AttributeError:\r\n        param_group = GroupTypeId.Data\r\n\r\n    # 3. Запускаем цикл по всем путям к семействам\r\n    for path in fam_paths:\r\n        if path is None: \r\n            continue\r\n            \r\n        # ПРОВЕРКА ИСКЛЮЧЕНИЯ: если путь файла начинается с пути исключаемой папки\r\n        if exclude_folder_path and exclude_folder_path.lower() in path.lower():\r\n            results.append(f\"{path} -> Пропущен (находится в исключенной папке)\")\r\n            continue\r\n            \r\n        # Проверяем, не является ли файл бэкапом вида .0001.rfa\r\n        if re.search(r\"\\.\\d{4}\\.rfa$\", path, re.IGNORECASE):\r\n            results.append(f\"{path} -> Пропущен (это файл резервной копии)\")\r\n            continue\r\n            \r\n        try:\r\n            # Открываем семейство в фоновом режиме\r\n            fam_doc = app.OpenDocumentFile(path)\r\n            \r\n            if fam_doc.IsFamilyDocument:\r\n                fam_manager = fam_doc.FamilyManager\r\n                \r\n                # Добавляем параметр через транзакцию\r\n                tx = Transaction(fam_doc, \"Add Shared Parameter\")\r\n                tx.Start()\r\n                try:\r\n                    fam_manager.AddParameter(target_def, param_group, is_instance)\r\n                    tx.Commit()\r\n                    \r\n                    # Сохраняем и закрываем файл семейства\r\n                    fam_doc.Save()\r\n                    fam_doc.Close(False)\r\n                    results.append(f\"{path} -> Успешно добавлен\")\r\n                except Exception as e:\r\n                    tx.RollBack()\r\n                    fam_doc.Close(False)\r\n                    results.append(f\"{path} -> Ошибка добавления: {str(e)}\")\r\n            else:\r\n                fam_doc.Close(False)\r\n                results.append(f\"{path} -> Файл не является семейством (.rfa)\")\r\n                \r\n        except Exception as e:\r\n            results.append(f\"{path} -> Не удалось открыть файл: {str(e)}\")\r\n\r\n# Выводим отчет по каждому файлу на выход нода\r\nOUT = results\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d91762324ac34552ba79135ec513c992",

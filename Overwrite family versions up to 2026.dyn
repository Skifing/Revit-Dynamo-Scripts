          "Name": "",
          "Description": "Путь к каталогу",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Возможность выбрать каталог в системе и возврат пути к нему",
      "HintPath": "C:\\Users\\popovvs1\\Desktop\\JOB\\REVIT\\Семейства\\01. В работе",
      "InputValue": "C:\\Users\\popovvs1\\Desktop\\JOB\\REVIT\\Семейства\\01. В работе"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nimport os\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# НАДЕЖНОЕ ИЗВЛЕЧЕНИЕ СТРОКИ ПУТИ (РЕШЕНИЕ ПРОБЛЕМЫ TYPEERROR)\r\nraw_input = IN\r\nif isinstance(raw_input, list):\r\n    root_folder = str(raw_input[0]) if len(raw_input) > 0 else \"\"\r\nelse:\r\n    root_folder = str(raw_input)\r\n\r\n# Очищаем от возможных случайных пробелов по краям\r\nroot_folder = root_folder.strip()\r\n\r\napp = RevitServices.Persistence.DocumentManager.Instance.CurrentUIApplication.Application\r\nlog = []\r\n\r\nopen_options = OpenOptions()\r\nopen_options.DetachFromCentralOption = DetachFromCentralOption.DoNotDetach\r\n\r\n# --- ЭТАП 1: Предварительная очистка старых бэкапов перед запуском ---\r\ndeleted_backups_count = 0\r\nif root_folder and os.path.isdir(root_folder):\r\n    for root, dirs, files in os.walk(root_folder):\r\n        for file in files:\r\n            # Ищем файлы, у которых перед расширением есть .00xx\r\n            if file.lower().endswith('.rfa') and len(file) > 9 and file[-9:-4].isdigit() and file[-10] == '.':\r\n                try:\r\n                    os.remove(os.path.join(root, file))\r\n                    deleted_backups_count += 1\r\n                except:\r\n                    pass\r\n\r\nif deleted_backups_count > 0:\r\n    log.append(\"Удалено старых бэкапов до начала обновления: {}\".format(deleted_backups_count))\r\n    log.append(\"-\" * 50)\r\n\r\n# --- ЭТАП 2: Сбор чистых файлов семейств для обновления ---\r\nfile_paths = []\r\nif root_folder and os.path.isdir(root_folder):\r\n    for root, dirs, files in os.walk(root_folder):\r\n        for file in files:\r\n            if file.lower().endswith('.rfa'):\r\n                # Дополнительная проверка, чтобы точно не взять бэкап\r\n                is_backup = len(file) > 9 and file[-9:-4].isdigit() and file[-10] == '.'\r\n                if not is_backup:\r\n                    file_paths.append(os.path.join(root, file))\r\n\r\n# --- ЭТАП 3: Обновление семейств и финальная зачистка ---\r\nif not file_paths:\r\n    log.append(\"Файлы .rfa в указанной папке не найдены. Проверенный путь: \" + root_folder)\r\nelse:\r\n    for path in file_paths:\r\n        try:\r\n            model_path = ModelPathUtils.ConvertUserVisiblePathToModelPath(path)\r\n            family_doc = app.OpenDocumentFile(model_path, open_options)\r\n            \r\n            family_doc.Save()\r\n            family_doc.Close(False)\r\n            log.append(\"Успешно обновлено: \" + path)\r\n            \r\n            # Сразу после сохранения удаляем свежесозданный бэкап .0001.rfa\r\n            backup_path = path[:-4] + \".0001.rfa\"\r\n            if os.path.exists(backup_path):\r\n                os.remove(backup_path)\r\n                \r\n        except Exception as e:\r\n            log.append(\"ОШИБКА при обработке \" + path + \": \" + str(e))\r\n\r\nOUT = log\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,

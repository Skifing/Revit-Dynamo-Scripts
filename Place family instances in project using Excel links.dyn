{
  "Uuid": "5475af84-1e8a-4104-8955-ed3c24499c20",
  "IsCustomNode": false,
  "Description": "",
  "Name": "БД_Фильтр_ADSK_расставить экз семейств в проекте по ссылкам из эксель",
  "ElementResolver": {
    "ResolutionMap": {
      "List": {
        "Key": "List",
        "Value": "BuiltIn.ds"
      }
    }
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Получаем данные со входов Dynamo\r\nraw_data = IN[0]   # Таблица из Excel (Вход IN[0])\r\nstep_mm = IN[1]    # Величина смещения в мм (Вход IN[1])\r\n\r\n# Переводим шаг смещения из мм в футы Revit\r\ntry:\r\n    step_feet = float(step_mm) / 304.8\r\nexcept:\r\n    step_feet = 1000.0 / 304.8 # Шаг по умолчанию (1 метр), если на вход ничего не подали\r\n\r\n# Извлекаем чистые пути к файлам семейства\r\npaths = []\r\nif isinstance(raw_data, list):\r\n    for item in raw_data:\r\n        if isinstance(item, list):\r\n            for subitem in item:\r\n                if subitem and \".rfa\" in str(subitem).lower():\r\n                    paths.append(str(subitem).strip())\r\n        elif item and \".rfa\" in str(item).lower():\r\n            paths.append(str(item).strip())\r\n\r\n# Собираем уровни проекта для размещения\r\nall_levels = FilteredElementCollector(doc).OfClass(Level).ToElements()\r\nbase_level = all_levels[0] if len(all_levels) > 0 else None\r\n\r\ncreated_instances = []\r\n\r\n# Начальная координата X (начнем с 0)\r\ncurrent_x_feet = 0.0\r\ndefault_y_feet = 0.0\r\ndefault_z_feet = 0.0\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# Жестко указываем CPython3 перегрузку LoadFamily, принимающую только строку\r\nload_family_by_path = doc.LoadFamily.Overloads[System.String]\r\n\r\nfor path in paths:\r\n    fam_name = path.split('\\\\')[-1].replace('.rfa', '').strip()\r\n    family = None\r\n    \r\n    try:\r\n        # 1. Проверяем, загружено ли семейство в проект\r\n        for f in FilteredElementCollector(doc).OfClass(Family):\r\n            if f.Name.lower() == fam_name.lower():\r\n                family = f\r\n                break\r\n                \r\n        # 2. Если семейства нет в памяти проекта — загружаем его универсальным вызовом\r\n        if not family:\r\n            # Исправлено: принимаем одиночный результат загрузки (без распаковки кортежа)\r\n            loaded_result = load_family_by_path(path)\r\n            \r\n            # Если вернулся объект типа Family\r\n            if isinstance(loaded_result, Family):\r\n                family = loaded_result\r\n            # Если вернулся bool (True) или объект загрузился, ищем его в базе проекта по имени\r\n            else:\r\n                for f in FilteredElementCollector(doc).OfClass(Family):\r\n                    if f.Name.lower() == fam_name.lower():\r\n                        family = f\r\n                        break\r\n        \r\n        # 3. Если семейство успешно найдено или загружено — создаем его экземпляр\r\n        if family:\r\n            symbols_ids = list(family.GetFamilySymbolIds())\r\n            if symbols_ids and len(symbols_ids) > 0:\r\n                first_symbol_id = symbols_ids[0]\r\n                symbol = doc.GetElement(first_symbol_id)\r\n                \r\n                if not symbol.IsActive:\r\n                    symbol.Activate()\r\n                \r\n                # Создаем точку со смещением по оси X\r\n                target_point = XYZ(current_x_feet, default_y_feet, default_z_feet)\r\n                \r\n                # Размещаем элемент\r\n                if base_level:\r\n                    instance = doc.Create.NewFamilyInstance(target_point, symbol, base_level, StructuralType.NonStructural)\r\n                else:\r\n                    instance = doc.Create.NewFamilyInstance(target_point, symbol, StructuralType.NonStructural)\r\n                \r\n                if instance:\r\n                    current_x_mm = round(current_x_feet * 304.8)\r\n                    created_instances.append(\"Успешно создан: {} (X = {} мм)\".format(fam_name, current_x_mm))\r\n                    \r\n                    # Увеличиваем координату X на заданный шаг для следующего прибора\r\n                    current_x_feet += step_feet\r\n                else:\r\n                    created_instances.append(\"Ошибка генерации экземпляра: \" + fam_name)\r\n            else:\r\n                created_instances.append(\"В семействе отсутствуют типы: \" + fam_name)\r\n        else:\r\n            created_instances.append(\"Не удалось загрузить rfa-файл: \" + fam_name)\r\n            \r\n    except Exception as e:\r\n        created_instances.append(\"Сбой на элементе {}: {}\".format(fam_name, str(e)))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Выводим финальный отчет в нод Watch\r\nif not created_instances:\r\n    OUT = [\"Скрипт не обнаружил путей к файлам семейства .rfa.\"]\r\nelse:\r\n    OUT = created_instances\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "531d96effd5e4863bbdd0c26e4a1df68",
